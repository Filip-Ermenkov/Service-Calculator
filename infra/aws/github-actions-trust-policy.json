{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsDeploy",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::847321857537:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:Filip-Ermenkov/Service-Calculator:environment:staging",
            "repo:Filip-Ermenkov/Service-Calculator:environment:production"
          ]
        }
      }
    }
  ]
}
