# Copy to terraform.tfvars (gitignored) and fill in. Secrets (neon_api_key) are
# better supplied via env: `export TF_VAR_neon_api_key=...` rather than a file.

aws_account_id = "847321857537"       # service-calculator-production
aws_region     = "eu-central-1"
domain_name    = "bulbau.lu"
alert_email    = "f.ermenkov@gmail.com"

# Cost guardrails (USD)
daily_budget_limit   = "1"
monthly_budget_limit = "10"

# ── Optional, enable per the README runbook AFTER importing ──────────────────
# Uptime + edge monitoring (Route 53 health check on /api/health, us-east-1 SNS
# topic + alarms). ~$1.00-1.50/month; needs a SECOND SNS email confirmation.
# Turn on before the public launch. See uptime.tf.
manage_uptime_monitoring = false
# CloudFront 5xx alarm — fill from `sst deploy --stage production`'s
# `cdnDistributionId` output to switch it on (leave empty to skip that one alarm).
cloudfront_distribution_id = ""   # e.g. "E3FHUL6KW814N6"
#
# NOTE: web_function_name / pdf_function_name are GONE. The per-stage Lambda
# alarms they configured now live in sst.config.ts, wired to the functions by
# reference so they can never point at a replaced function. Delete those two
# lines from your own terraform.tfvars.

# Neon — keep false until the existing project is `terraform import`ed
manage_neon       = false
# neon_api_key    = "" # supply via TF_VAR_neon_api_key instead
neon_project_name = "Service-Calculator"   # the live project's DISPLAY name (not "bulbau-lu")
neon_region_id    = "aws-eu-central-1"
neon_pg_version   = 18
neon_history_retention_seconds = 21600   # 6h — matches the live project; raise deliberately

# GitHub-Actions deploy role — keep false until the existing role is imported
manage_deploy_role = false
deploy_role_name   = "gh-actions-bulbau-staging-deploy"

# SES sending identity (Phase 4 part 2 — quote-by-email). Keep false until you're
# ready to provision it; flip to true and `terraform apply` to create the domain
# identity + its DKIM/SPF/DMARC/MAIL-FROM records (verifies automatically, DNS is
# in-zone). Then set the SST EmailSender secret + request SES production access.
manage_ses = false
