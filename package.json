{
  "name": "bulbau-lu",
  "version": "0.1.0",
  "description": "bulbau.lu — multilingual service calculator site (Next.js + Payload CMS)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "sst install",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "migrate:verify": "node scripts/verify-migrations.mjs",
    "seed:ci": "cross-env NODE_OPTIONS=--no-deprecation payload run tests/helpers/seedContent.run.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:int && npm run test:e2e",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "lhci": "lhci autorun",
    "deploy:staging": "sst deploy --stage staging",
    "deploy:production": "sst deploy --stage production"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1130.0",
    "@aws-sdk/client-dynamodb": "^3.1132.0",
    "@aws-sdk/client-lambda": "^3.1132.0",
    "@aws-sdk/client-sesv2": "^3.1132.0",
    "@aws-sdk/client-ssm": "^3.1132.0",
    "@aws-sdk/client-translate": "^3.1130.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@sparticuz/chromium": "^149.0.0",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "graphql": "17.0.2",
    "jose": "6.2.12",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "otplib": "13.5.0",
    "payload": "3.89.0",
    "puppeteer-core": "^25.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/compat": "2.1.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.5.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "sst": "4.17.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "fast-uri": "^3.1.7",
    "undici": "^7.29.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "baseline-browser-mapping": "^2.11.0",
    "qs": "^6.16.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@lhci/cli": {
      "uuid": "^11.1.1"
    }
  }
}
